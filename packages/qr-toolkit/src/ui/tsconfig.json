{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "declaration": false,
    "allowArbitraryExtensions": true,
    "paths": {
      "#build/ui": ["../../node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["../../node_modules/.nuxt-ui/ui/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": []
}
