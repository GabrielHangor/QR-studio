{
  "name": "@qr-studio/toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Headless QR encoding and SVG rendering for QR Studio",
  "license": "ISC",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "import": "./dist/i18n/ru.js"
    },
    "./i18n/en": {
      "types": "./dist/i18n/en.d.ts",
      "import": "./dist/i18n/en.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./package.json": "./package.json",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/scan/tsconfig.json && pnpm prepare:ui && vue-tsc --noEmit -p src/ui/tsconfig.json",
    "test": "vitest run",
    "test:scan": "vitest run --config vitest.scan.config.ts",
    "test:scan:install": "playwright install chromium",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "lint:fix": "oxlint --fix --deny-warnings"
  },
  "dependencies": {
    "ol": "10.11.0",
    "qr": "0.7.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@nuxt/ui": "4.12.0",
    "@qr-studio/theme": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "5.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13",
    "zxing-wasm": "3.1.5"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    }
  }
}
