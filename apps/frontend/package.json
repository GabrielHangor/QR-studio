{
  "name": "@qr-studio/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @qr-studio/toolkit prepare:ui && vite --host 127.0.0.1",
    "build": "vite build && vue-tsc --noEmit",
    "typecheck": "pnpm prepare:ui && vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare:ui": "node scripts/prepare-ui.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "@qr-studio/theme": "workspace:*",
    "@qr-studio/toolkit": "workspace:*",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@iconify-json/ri": "1.2.10",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
