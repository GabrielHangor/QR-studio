# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Public frontend origin used in links sent by email.
APP_FRONTEND_URL=http://localhost:5173

# PostgreSQL (local development only)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=qr_studio
DB_PASSWORD=qr_studio
DB_DATABASE=qr_studio

# Session
SESSION_DRIVER=database

# Exact frontend origins, separated by commas; keep the same hostname as the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Queue: the database driver stores jobs in PostgreSQL; run `node ace queue:work` for a worker.
QUEUE_DRIVER=database

# Mail: local Mailpit (docker compose up -d mailpit). UI: http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_FROM_NAME=QR Studio
MAIL_FROM_ADDRESS=no-reply@localhost
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
